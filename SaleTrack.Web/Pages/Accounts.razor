@page "/accounts"
@inject AccountService AccountData

<h1>Accounts</h1>
<p>A purchase is a debit. A sale is a credit.</p>

<div class="balance">Current balance: Rs @balance.ToString("N0")</div>

<table>
    <thead><tr><th>Date</th><th>Type</th><th>Description</th><th>Debit</th><th>Credit</th></tr></thead>
    <tbody>
        @foreach (AccountEntry entry in entries)
        {
            <tr>
                <td>@entry.EntryDate.ToString("g")</td><td>@entry.Type</td><td>@entry.Description</td>
                <td>@Money(AccountCalculator.GetDebit(entry))</td>
                <td>@Money(AccountCalculator.GetCredit(entry))</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<AccountEntry> entries = new();
    private decimal balance;

    protected override async Task OnInitializedAsync()
    {
        entries = await AccountData.GetEntriesAsync();
        balance = AccountCalculator.GetBalance(entries);
    }

    private static string Money(decimal value) => value == 0 ? "-" : $"Rs {value:N0}";
}
